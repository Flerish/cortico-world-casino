{
  // 面板源码:浏览器侧,带 DOM;对 cortico/* 只许 import type。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // import type 拉进 cortico 的 .ts 源码,里面有 node:crypto;类型检查需要 node 类型。
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src/webui/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
