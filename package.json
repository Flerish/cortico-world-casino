{
  "name": "cortico-world-casino",
  "version": "0.6.1",
  "type": "module",
  "description": "月下牌桌:一张就在电脑里的标准 21 点牌桌,与你的 AI 同桌对打——选庄、下注、要牌、停牌、分牌、保险,绿呢桌面实时显示双方的牌;筹码是游戏内数字,不涉及真钱。",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico",
    "blackjack",
    "cards",
    "game",
    "local"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "月下牌桌",
    "webUiClient": "dist/webui.js",
    "locales": {
      "en": {
        "displayName": "Moonlit Table",
        "description": "A local blackjack table you share with your AI: pick the dealer, bet, hit and stand; chips are game numbers only."
      }
    },
    "tags": [
      "game",
      "experimental"
    ],
    "describe": "describe.json"
  },
  "files": [
    "src",
    "dist",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "build:webui": "node scripts/build-webui.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webui.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.17",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
