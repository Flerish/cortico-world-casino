{
  "name": "cortico-world-casino",
  "version": "0.6.1",
  "type": "module",
  "description": "月下牌桌:一张就在电脑里的牌桌,和你的 AI 同桌对打——21 点(选庄、下注、要牌、分牌、保险、投降)与抽鬼牌(藏一张、点选抽牌、终局亮牌)两个游戏,绿呢桌面实时显示双方手牌;筹码是游戏内数字,不涉及真钱。",
  "license": "MIT",
  "homepage": "https://github.com/Flerish/cortico-world-casino#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flerish/cortico-world-casino.git"
  },
  "bugs": {
    "url": "https://github.com/Flerish/cortico-world-casino/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "blackjack",
    "oldmaid",
    "cards",
    "game",
    "local"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "月下牌桌",
    "webUiClient": "dist/webui.js",
    "locales": {
      "en": {
        "displayName": "Moonlit Table",
        "description": "A card table inside your computer shared with your AI: blackjack (pick the dealer, bet, hit, split, insure, surrender) and Old Maid (one card hidden, click a face-down card to draw, reveal at the end) on one felt table that shows both hands live; chips are game numbers only."
      }
    },
    "tags": [
      "game",
      "experimental"
    ],
    "describe": "describe.json"
  },
  "files": [
    "src",
    "dist",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "build:webui": "node scripts/build-webui.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webui.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.17",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
